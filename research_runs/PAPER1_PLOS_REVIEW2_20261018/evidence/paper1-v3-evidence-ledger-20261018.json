  "primary_claim": {
    "allowed": "Under the archived BROAD/tail_min_recall protocol, the S60 source configuration improved external participant-averaged weaker-class recall relative to S9 by 21.1667 percentage points (95% t CI 17.1226–25.2107).",
    "scope": "Exploratory evaluation in the 85-participant Dreyer cohort; internally frozen contrast; not first-use independent confirmation, not universal effect or isolated causal participant-count effect.",
    "s9_mean_percent": 27.31372549019608,
    "s60_mean_percent": 48.480392156862756,
    "improved": 72,
    "declined": 10,
    "unchanged": 3,
    "participant_count_scope": "descriptive counts, not additional prespecified test",
    "checkpoint_duration_note": "BROAD/tail_min_recall selects S9 epoch 27, S29 epoch 5 and S60 epoch 5; contrast is complete source-configuration/pipeline comparison, despite equal full trajectory budgets."
  },
  "mandatory_nonpositive_results": [
    {
      "result": "S60 tail_min_recall versus mean_ba on weaker-class recall",
      "difference_pp": -0.8725490196078431,
      "holm_p": 0.9998588961295976,
      "interpretation": "No evidence of the tail-focused selector improving over mean balanced-accuracy selection; non-significance does not establish equivalence. Keep in main Results and the full prespecified secondary table."
    },
    {
      "result": "S60 versus S29 on weaker-class recall",
      "difference_pp": -0.5490196078431373,
      "holm_p": 0.9998588961295976,
      "interpretation": "No evidence of further improvement over the fixed intermediate source condition; cannot claim monotonic scaling, an identified optimum, equivalence or saturation law. Keep in main Results and secondary table."
    },
    {
      "result": "Primary weaker-class-recall individual declines",
      "declined": 10,
      "unchanged": 3,
      "interpretation": "72 improved does not mean universal benefit. Show all 85 changes, including negative and zero values."
    },
    {
      "result": "CSP comparator",
      "S60_csp_ba_percent": 65.37745098039215,
      "S60_primary_neural_ba_percent": 64.17156862745098,
      "interpretation": "Descriptive baseline was not part of the neural inferential family; cannot claim neural or proposed-pipeline superiority, and do not add a favorable post-hoc model-comparison test."
    }
  ],
  "supported_contributions": [
    {
      "label": "Participant-centered source-expansion evaluation",
      "text": "Joint reporting of balanced accuracy and each participant's weaker-class recall makes the effect of source configuration visible beyond aggregate accuracy.",
      "evidence": "Fixed primary endpoint and all four archived comparisons; 85 paired participants."
    },
    {
      "label": "Controlled optimization-budget benchmark",
      "text": "Nested S9/S29/S60 source configurations are evaluated with one frozen 18-channel dimensionless processing recipe and the same full-trajectory optimizer-update budget.",
      "boundary": "Cohort, trial availability, sampling distribution and source-selected checkpoint change together; not a causal participant-count experiment."
    },
    {
      "label": "Source-only checkpoint-selection evidence",
      "text": "Eight frozen source-selection rules and both broadband/shared pipelines are retained across all source conditions; whole-participant folds, seed averaging, dataset/person weighting and exact ties are traceable.",
      "boundary": "The proposed tail-focused rule does not outperform the mean-BA comparator in the frozen secondary test; no novel SOTA algorithm claim."
    },
    {
      "label": "Benefit distribution rather than mean-only reporting",
      "text": "All participant-paired effects and the 72/10/3 improve/decline/tie split accompany mean estimates and uncertainty.",
      "boundary": "These are descriptive heterogeneity summaries, not independent subgroup confirmation or benefit guarantees."
    },
    {
      "label": "An auditable research artifact chain",
      "text": "Frozen source identities, exact selector/checkpoint bindings, 108 trajectory contracts and saved prediction/statistic audits provide a reproducibility resource.",
